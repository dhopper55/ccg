# .mjs workers must have an explicit JS MIME type — Cloudflare Pages does not
# auto-assign application/javascript for .mjs, causing Worker MIME rejections.
/admin/assets/*.mjs
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

/guitars-and-gear-for-sale/assets/*.mjs
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable

# Hashed JS/CSS assets cached forever (filename changes on every build)
/admin/assets/*
  Cache-Control: public, max-age=31536000, immutable

/guitars-and-gear-for-sale/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Never cache the admin SPA entry points so new JS bundles are always picked up
/admin/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/guitars-and-gear-for-sale/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/admin
  Cache-Control: no-cache, no-store, must-revalidate

/guitars-and-gear-for-sale
  Cache-Control: no-cache, no-store, must-revalidate

/admin/*
  Cache-Control: no-cache, no-store, must-revalidate

/guitars-and-gear-for-sale/*
  Cache-Control: no-cache, no-store, must-revalidate

/decoders/*
  Cache-Control: no-cache, no-store, must-revalidate

/august_2026_budget.html
  X-Robots-Tag: noindex, nofollow
