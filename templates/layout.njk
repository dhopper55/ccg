<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="apple-touch-icon" sizes="180x180" href="../images/favicon/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="../images/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="../images/favicon/favicon-16x16.png">
  <link rel="shortcut icon" href="../images/favicon/favicon.ico">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <link rel="canonical" href="https://www.coalcreekguitars.com/decoders/{{ pageSlug }}.html">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.coalcreekguitars.com/decoders/{{ pageSlug }}.html">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ ogDescription }}">
  <meta property="og:image" content="https://www.coalcreekguitars.com/images/coal-creek-logo.png">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="https://www.coalcreekguitars.com/decoders/{{ pageSlug }}.html">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ ogDescription }}">
  <meta name="twitter:image" content="https://www.coalcreekguitars.com/images/coal-creek-logo.png">

  <link rel="stylesheet" href="../styles.css?version=560727">

  <!-- Structured Data -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.coalcreekguitars.com/#organization",
      "name": "Coal Creek Guitars",
      "url": "https://www.coalcreekguitars.com",
      "logo": "https://www.coalcreekguitars.com/images/coal-creek-logo.png"
    },
    {
      "@type": "WebSite",
      "@id": "https://www.coalcreekguitars.com/#website",
      "url": "https://www.coalcreekguitars.com",
      "name": "Coal Creek Guitars",
      "publisher": {
        "@id": "https://www.coalcreekguitars.com/#organization"
      }
    },
    {
      "@type": "WebPage",
      "@id": "https://www.coalcreekguitars.com/decoders/{{ pageSlug }}.html#webpage",
      "url": "https://www.coalcreekguitars.com/decoders/{{ pageSlug }}.html",
      "name": "{{ decoderTitle }}",
      "description": "{{ metaDescription }}",
      "isPartOf": {
        "@id": "https://www.coalcreekguitars.com/#website"
      },
      "about": {
        "@type": "Brand",
        "name": "{{ brandShortName or brandName }}"{% if brandAltName %},
        "alternateName": "{{ brandAltName }}"{% endif %}
      },
      "publisher": {
        "@id": "https://www.coalcreekguitars.com/#organization"
      }
    },
    {
      "@type": "WebApplication",
      "name": "{{ decoderTitle }}",
      "description": "{{ metaDescription }}",
      "url": "https://www.coalcreekguitars.com/decoders/{{ pageSlug }}.html",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Web Browser",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "provider": {
        "@id": "https://www.coalcreekguitars.com/#organization"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.coalcreekguitars.com/index.html"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Guitar Serial Number Lookup/Decoder",
          "item": "https://www.coalcreekguitars.com/decoders/guitar-serial-decoder-lookup.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "{{ decoderTitle }}",
          "item": "https://www.coalcreekguitars.com/decoders/{{ pageSlug }}.html"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {% for faq in faqs %}
        {
          "@type": "Question",
          "name": "{{ faq.question }}",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{{ faq.answerPlain or faq.answer }}"
          }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
  ]
}
  </script>
</head>
<body data-preselect-brand="{{ brand }}">
  <nav class="site-nav">
    <a href="../index.html" class="nav-logo">
      <img src="../images/coal-creek-logo.png" alt="Coal Creek Guitars">
    </a>
    <a href="guitar-serial-decoder-lookup.html" class="nav-home">Back</a>
  </nav>

  <div class="container">
    <h1>{{ h1Title or decoderTitle }}</h1>

    <div class="decoder-update-note" aria-label="Decoder update status">
      <p>Our decoders are constantly being updated</p>
      <p>Current as of <span id="decoder-current-as-of">{{ decoderDate }}</span></p>
    </div>

    <div class="brand-header">
      <img src="../images/brand-logos/{{ brandLogo }}" alt="{{ brandName }}" class="brand-logo {{ brandLogoClass }}">
      {% block brandDescription %}{% endblock %}
    </div>

    <div class="input-section">
      <div class="form-group">
        <label for="serial">Serial Number:</label>
        <input type="text" id="serial" placeholder="{{ serialPlaceholder }}" autocomplete="off">
      </div>

      <button id="decode-btn">Decode Serial Number</button>
    </div>

    {% block beforeResult %}{% endblock %}

    <div id="result" class="result-section hidden">
      <h2>Guitar Information</h2>
      <div id="result-content">
</div>

      <div class="decoder-guide-links">
        <a href="../how-to-value-a-used-guitar.html">How to Value a Used Guitar</a>
        <span class="decoder-guide-separator">•</span>
        <a href="../how-to-list-a-guitar-for-sale.html">How to List a Guitar for Sale</a>
      </div>

      <div class="decoder-guide-links decoder-guide-links-compact">
        <a href="../guitar-repair-demo-lesson-videos.html">Repair tips &amp; tutorials</a>
      </div>

    </div>

    <div id="error" class="error-section hidden"></div>

    {% block afterResult %}{% endblock %}

    <section class="decoder-faq">
      <h2>{{ faqTitle }}</h2>
      {% for faq in faqs %}
      <div class="decoder-faq-item">
        <h3>{{ faq.question }}</h3>
        <p>{{ faq.answer }}</p>
      </div>
      {% endfor %}
    </section>

    {% block decoderNote %}
    <div class="decoder-note">
      <p>Note: If you try a serial number and the decoder is not able to decode it, please <a href="../contact-us.html">contact us</a> and let us know so we can check the number and fix the decoder. Thank you!</p>
    </div>
    {% endblock %}

    <div class="back-link">
      <a href="guitar-serial-decoder-lookup.html">&larr; Back to brand selection</a>
    </div>
  </div>

  {% block howtoModal %}{% endblock %}

  {% block afterContent %}{% endblock %}

  <footer class="site-footer">
    <div class="footer-content">
      <p class="footer-contact"><a href="../contact-us.html">Contact Us</a> | <a href="../privacy-policy.html">Privacy Policy</a> | <a href="../terms-conditions.html">Terms and Conditions</a></p>
      <p class="footer-copyright">&copy; <span class="footer-year"></span> Coal Creek Guitars. All rights reserved.</p>
    </div>
  </footer>

  <script type="module" src="../dist/main.js?version=253856"></script>
  <script>
    {% block customScripts %}{% endblock %}
    (function() {
      const year = new Date().getFullYear();
      document.querySelectorAll('.footer-year').forEach((el) => {
        el.textContent = year;
      });
    })();
  </script>
</body>
</html>
